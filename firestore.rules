rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Pro Coach was rebuilt around a much narrower concept: training-plan creation and
    // distribution, no login at all. A "workspace" is a shared code (not a password, not
    // real auth) -- the manager creates one and shares the code with coaches, who enter it
    // to see the same data. Anyone holding the code has full read/write to that workspace's
    // documents. This is a trust boundary, not real security -- there is no Firebase Auth
    // in this app anymore, so no rule here can key off request.auth.
    match /fc_workspaces/{code} {
      allow read: if true;
      allow create: if request.resource.data.code == code;
      allow update, delete: if false;
    }
    match /fc_coaches/{docId} {
      allow read, write: if true;
    }
    match /fc_sessions/{docId} {
      allow read, write: if true;
    }

    // This Firestore project (soccer-26e99) is also used by athleteiq.html, an unrelated app
    // that shares nothing with Pro Coach except the project -- it keys its own collections with
    // the 'ath_' prefix instead of 'fc_' (Firestore rules can't wildcard-match a name *prefix*
    // within a path segment, so each of its known collections is listed explicitly).
    match /ath_clubcoaches/{docId} { allow read, write: if true; }
    match /ath_clubfields/{docId} { allow read, write: if true; }
    match /ath_clubgroupplans/{docId} { allow read, write: if true; }
    match /ath_clubschedule/{docId} { allow read, write: if true; }
    match /ath_coachtrainings/{docId} { allow read, write: if true; }
    match /ath_profiles/{docId} { allow read, write: if true; }

    // Everything else (anything neither fc_* nor the ath_* collections above) is denied by
    // default -- if AthleteIQ (or another app sharing this project) adds a new collection later,
    // it needs its own explicit rule here too.
  }
}
